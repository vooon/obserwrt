#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034          # consumed by /etc/rc.common
USE_PROCD=1

START=98
STOP=98

start_service()
{
	procd_open_instance
	procd_set_param command /usr/bin/obserwrt
	procd_set_param env BPF_OBJ=/lib/bpf/obserwrt-bpf.o
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

# Reload on /etc/config/obserwrt changes (config read at startup only).
reload_service()
{
	stop
	start
}

service_triggers()
{
	procd_add_reload_trigger "obserwrt"
}
