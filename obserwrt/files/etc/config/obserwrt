
config obserwrt 'main'
	# Observe these Linux netdevs (exact names or glob patterns).
	# Empty by default: obserwrt attaches to nothing until configured.
	list device 'awg*'
	option tcp_timeout '300'
	option udp_timeout '60'
	option icmp_timeout '30'
	option general_timeout '10'
	# Enable Prometheus self-observability via the node-exporter textfile
	# collector by pointing at a writable metrics file (atomic temp+rename).
	# Unset/empty disables metrics. Metrics are rewritten at most every
	# `prometheus_interval` seconds.
	# option prometheus_textfile '/run/prometheus/textfile/obserwrt.prom'
	option prometheus_interval '20'

# IPFIX exporter (opt-in). Enable with 'option enabled' and point at a
# collector. `collector_host` is an IP address (hostname resolution is a
# follow-up); `source_address` optionally pins the source IP; `observation_domain`
# disambiguates the observation domain (per-router) in multi-collector setups.
config exporter_ipfix 'ipfix'
	option enabled '0'
	option collector_host '192.0.2.10'
	option collector_port '4739'
	option observation_domain '1'
	# option source_address ''

# Syslog exporter (opt-in). Empty syslog_host uses local syslog; a non-empty
# syslog_host is resolved once and used as a remote UDP syslog endpoint.
# `hostname` sets the RFC 5424 HOSTNAME used to identify this probe; empty
# defaults to the router hostname.
config exporter_syslog 'syslog'
	option enabled '0'
	option syslog_host ''
	option syslog_port '514'
	option protocol 'udp'
	option format 'json'
	# option hostname ''
	# option source_address ''
