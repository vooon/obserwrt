
config obserwrt 'main'
	# Observe these Linux netdevs (exact names or glob patterns).
	# Empty by default: obserwrt attaches to nothing until configured.
	list device 'awg*'

# IPFIX exporter (opt-in). Enable with 'option enabled' and point at a
# collector. `collector_host` is an IP address (hostname resolution is a
# follow-up); `source_address` optionally pins the source IP.
config exporter_ipfix 'ipfix'
	option enabled '0'
	option collector_host '192.0.2.10'
	option collector_port '4739'
	# option source_address ''

# Syslog exporter (opt-in). Empty destination uses local syslog; a non-empty
# destination is resolved once and used as a remote UDP syslog endpoint.
config exporter_syslog 'syslog'
	option enabled '0'
	option destination ''
	option port '514'
	option protocol 'udp'
	option format 'json'
