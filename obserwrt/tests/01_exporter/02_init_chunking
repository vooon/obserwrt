Drive exporter_ipfix.init() from the mocked UCI configuration: it should enable
the collector from the config, bind the configured source address, and be
ready to emit once connected. Then a large batch of records must be split into
chunked datagrams (<= 1200 B each) and flushed with correct accounting.

-- File uci/obserwrt.json --
{
  "exporter_ipfix": {
    ".name": "ipfix",
    "enabled": "1",
    "collector_host": "192.0.2.10",
    "collector_port": "4739",
    "source_address": "192.0.2.99"
  }
}
-- End --

-- Testcase --
import * as struct from 'struct';
import * as ipfix from 'exporter_ipfix';

function v4in6(a, b, c, d)
{
	return '\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xff' + chr(a, b, c, d);
}

if (!ipfix.init())
	die('init failed');

printf("datagrams after init=%d\n", length(global.MOCK_SENT));
for (let i = 0; i < length(global.MOCK_SENT); i++)
	printf("  #%d host=%s port=%d len=%d\n",
		i, global.MOCK_SENT[i].host, global.MOCK_SENT[i].port, length(global.MOCK_SENT[i].data));

for (let j = 0; j < 30; j++) {
	let src = '\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01',
	    dst = '\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02';

	ipfix.emit({
		ifindex: 30, direction: 1, family: 6, protocol: 17,
		src, dst, sport: 53, dport: 443 + j, icmp_type: 0, icmp_code: 0,
	}, {
		packets: 1, bytes: 64, first_seen: 1700000000000000000,
		last_seen: 1700000000000000000, tcp_flags: 0,
	}, false);
}

ipfix.flush();

let after_flush = length(global.MOCK_SENT);
printf("total datagrams=%d\n", after_flush);

for (let i = 1; i < after_flush; i++) {
	let d = global.MOCK_SENT[i].data;
	let hdr = struct.unpack('!HHIII', d);
	let setId = struct.unpack('!HH', substr(d, 16, 4))[0];

	printf("  [%d] version=%d seq=%d first_set=%d len=%d\n",
		i, hdr[0], hdr[3], setId, length(d));
}
-- End --

