Encode two fixed flows (one IPv4/TCP/egress, one IPv6/UDP/ingress) through
exporter_ipfix.connect()/emit()/flush() and decode the captured datagrams to
verify the wire layout end-to-end (addresses, ports, protocol, counters,
direction ifindex mapping, template sets, message header).

-- Testcase --
import * as struct from 'struct';
import * as ipfix from 'exporter_ipfix';

function v4in6(a, b, c, d)
{
	return '\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xff' + chr(a, b, c, d);
}

if (!ipfix.connect('192.0.2.1', '4739', null))
	die('connect failed');

/* IPv4 TCP egress, ifindex 29, src 192.0.2.1 -> 198.51.100.2 */
ipfix.emit({
	ifindex: 29, direction: 1, family: 4, protocol: 6,
	src: v4in6(192, 0, 2, 1), dst: v4in6(198, 51, 100, 2),
	sport: 12345, dport: 80, icmp_type: 0, icmp_code: 0,
}, {
	packets: 10, bytes: 12340, first_seen: 1700000000000000000,
	last_seen: 1700006000000000000, tcp_flags: 0x18,
}, false);

/* IPv6 UDP ingress, ifindex 30, src 2001:db8::1 -> 2001:db8::2 */
const ip6_1 = '\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01';
const ip6_2 = '\x20\x01\x0d\xb8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02';

ipfix.emit({
	ifindex: 30, direction: 0, family: 6, protocol: 17,
	src: ip6_1, dst: ip6_2, sport: 53, dport: 443,
	icmp_type: 0, icmp_code: 0,
}, {
	packets: 2, bytes: 200, first_seen: 1700000000000000000,
	last_seen: 1700003000000000000, tcp_flags: 0,
}, false);

ipfix.flush();

printf("datagrams=%d\n", length(global.MOCK_SENT));
for (let i = 0; i < length(global.MOCK_SENT); i++) {
	let d = global.MOCK_SENT[i].data;
	let hdr = struct.unpack('!HHIII', d);

	printf("[%d] host=%s len=%d version=%d exportTime=%d seq=%d domain=%d\n",
		i, global.MOCK_SENT[i].host, length(d), hdr[0], hdr[2], hdr[3], hdr[4]);

	for (let pos = 16; pos < length(d); ) {
		let set = struct.unpack('!HH', substr(d, pos, 4)),
		    setId = set[0], setLen = set[1],
		    body = substr(d, pos + 4, setLen - 4);

		if (setId == 2) {
			let b = 0;

			while (b < length(body)) {
				let t = struct.unpack('!HH', substr(body, b, 4));
				printf("  templates tid=%d fields=%d\n", t[0], t[1]);
				b += 4 + t[1] * 4;
			}
		}
		else if (setId == 256) {
			let r = struct.unpack('!4s4sHHBQQQQHII', body);
			printf("  v4 %d.%d.%d.%d -> %d.%d.%d.%d sport=%d dport=%d proto=%d pkts=%d bytes=%d start=%d end=%d tcp=0x%02x ingress_if=%d egress_if=%d\n",
				ord(r[0], 0), ord(r[0], 1), ord(r[0], 2), ord(r[0], 3),
				ord(r[1], 0), ord(r[1], 1), ord(r[1], 2), ord(r[1], 3),
				r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10], r[11]);
		}
		else if (setId == 257) {
			let r = struct.unpack('!16s16sHHBQQQQHII', body);
			printf("  v6 sport=%d dport=%d proto=%d pkts=%d bytes=%d start=%d end=%d tcp=0x%02x ingress_if=%d egress_if=%d\n",
				r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10], r[11]);
		}

		pos += 4 + setLen - 4;
	}
}
-- End --

