{
  "obserwrt": {
    ".name": "main",
    "prometheus_textfile": "/tmp/obserwrt-prom-write.prom",
    "prometheus_interval": "20"
  }
}
-- End --

-- Testcase --
import * as metrics from 'metrics';
import { readfile, unlink } from 'fs';

const PATH = '/tmp/obserwrt-prom-write.prom';

unlink(PATH);
unlink(PATH + '.tmp');

if (!metrics.init())
	die('metrics not enabled');

/* dispatch counting (per-flow args are unused now) */
metrics.observe(null, null, false);
metrics.observe(null, null, false);
metrics.observe(null, null, false);
metrics.observe(null, null, false);

metrics.record_error();

metrics.state({ active: 2, map: 3, packets: 16, bytes: 1464 }, [ 'awg_sp_pa', 'awg_sp_ka' ]);

metrics.write();

let d = readfile(PATH);
function has(s) { return index(d, s) != -1; }

printf("flows=%d errors=%d packets=%d bytes=%d live=%d map=%d limit=%d devcount=%d devpa=%d devka=%d\n",
	has('obserwrt_flows_exported_total 4'),
	has('obserwrt_export_errors_total 1'),
	has('obserwrt_packets 16'),
	has('obserwrt_bytes 1464'),
	has('obserwrt_flows_active 2'),
	has('obserwrt_bpf_map_entries 3'),
	has('obserwrt_bpf_map_limit 4096'),
	has('obserwrt_devices_attached 2'),
	has('obserwrt_device_attached{ifname="awg_sp_pa"} 1'),
	has('obserwrt_device_attached{ifname="awg_sp_ka"} 1'));

unlink(PATH);
-- End --

-- Expect stdout --
flows=1 errors=1 packets=1 bytes=1 live=1 map=1 limit=1 devcount=1 devpa=1 devka=1
-- End --